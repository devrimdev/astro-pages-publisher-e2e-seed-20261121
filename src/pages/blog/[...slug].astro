---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import { getGitHubEditUrl } from "../../lib/github";
import { formatDate } from "../../lib/format";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts
    .filter((p) => !p.id.startsWith("_") && !p.id.startsWith("."))
    .map((post) => ({
      params: { slug: post.id },
      props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const githubEdit = getGitHubEditUrl(post.filePath ?? `src/content/blog/${post.id}.md`);
---

<Layout title={post.data.title} description={post.data.description}>
  <div class="editable-block post-header">
    <h1 class="post-title">
      {post.data.title}
    </h1>
    <time class="post-date" datetime={post.data.pubDate.toISOString()}>
      {formatDate(post.data.pubDate)}
    </time>
    <a href={githubEdit} target="_blank" rel="noopener" class="edit-pencil" title="Edit this post">✎</a>
  </div>

  <article class="post-body">
    <Content />
  </article>

  <p class="post-back">
    <a href={`${base}/`}>← Back</a>
  </p>
</Layout>
