---
import Layout from "../layouts/Layout.astro";
import Profile from "../components/Profile.astro";
import site from "../content/site.json";
import { getCollection } from "astro:content";
import { fetchRepositories, getGitHubEditUrl, describeFailure } from "../lib/github";
import { formatDate } from "../lib/format";

const allPosts = await getCollection("blog");
const posts = allPosts
  .filter((p) => !p.id.startsWith("_") && !p.id.startsWith("."))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const postsByYear = posts.reduce((acc, post) => {
  const year = post.data.pubDate.getUTCFullYear();
  if (!acc[year]) acc[year] = [];
  acc[year].push(post);
  return acc;
}, {} as Record<number, typeof posts>);

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const editBio = getGitHubEditUrl("src/content/site.json");
const editNewPost = getGitHubEditUrl("src/content/blog/.new-post.md");
const repos = await fetchRepositories();
const shown = repos.ok ? repos.data.slice(0, 5) : [];
---

<Layout title="Overview">
  <div class="page-grid overview-grid">
    <Profile editUrl={editBio} editTitle="Edit site configuration">
      {site.bio}
      <Fragment slot="after">
        <div class="repos editable-block">
          <div class="repos-label">Public repositories from this account</div>
          {
            !repos.ok ? (
              <p class="note note-error" role="status">{describeFailure(repos)}</p>
            ) : shown.length === 0 ? (
              <p class="note">No public repositories were found for this GitHub account.</p>
            ) : (
              <>
                <ul class="repo-list">
                  {shown.map((r) => (
                    <li>
                      <a href={r.url} target="_blank" rel="noopener">{r.name}</a>
                      {r.description && <span class="repo-desc">{r.description}</span>}
                    </li>
                  ))}
                </ul>
                <a href={`${base}/repositories`} class="repos-all">Browse all repositories →</a>
              </>
            )
          }
        </div>
        <div class="profile-actions">
          <a href={`${base}/getting-started`}>Get started</a>
          <a href={`${base}/templates`}>Browse templates</a>
          <a href={editNewPost} target="_blank" rel="noopener">+ New post</a>
        </div>
      </Fragment>
    </Profile>

    <section class="overview-content">
      <p class="eyebrow">Open-source Astro starter · GitHub Pages</p>
      <h1>Publish a website from your GitHub repository.</h1>
      <p class="hero-copy">
        Astro Pages Publisher gives you a configurable site, reusable content templates,
        automatically generated navigation, and a secure GitHub Pages deployment workflow.
        Fork the repository, rename it, and adapt the content to your project.
      </p>

      <div class="overview-actions">
        <a class="action-link action-primary" href={`${base}/getting-started`}>Set up your fork →</a>
        <a class="action-link" href={`${base}/how-it-works`}>How it works</a>
        <a class="action-link" href={`${base}/templates`}>Explore the templates</a>
      </div>

      <div class="feature-grid">
        <article class="feature-card">
          <h2>Content first</h2>
          <p>Write posts in Markdown and build pages from small Astro templates. No database is required.</p>
        </article>
        <article class="feature-card">
          <h2>GitHub aware</h2>
          <p>Profile, public repositories, commits, and edit links are derived from the repository running the build.</p>
        </article>
        <article class="feature-card">
          <h2>Fork friendly</h2>
          <p>Site URLs and base paths are detected automatically, including project sites and user sites.</p>
        </article>
        <article class="feature-card">
          <h2>Validated builds</h2>
          <p>Template checks, content checks, tests, a production build, and a static-output security scan run in CI.</p>
        </article>
      </div>

      <div class="year-block overview-writing">
        <div class="section-heading-row">
          <h2>Guides and examples</h2>
          <span class="muted-label">Included starter articles</span>
        </div>
        {
          Object.keys(postsByYear)
            .sort((a, b) => Number(b) - Number(a))
            .map((year) => (
              <div class="writing-year">
                <h3>{year}</h3>
                {postsByYear[Number(year)].map((post) => (
                  <div class="post-row">
                    <a href={`${base}/blog/${post.id}/`}>{post.data.title}</a>
                    <div class="dots" />
                    <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
                  </div>
                ))}
              </div>
            ))
        }
      </div>
    </section>
  </div>
</Layout>
