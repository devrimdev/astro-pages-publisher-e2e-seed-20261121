# Optional local overrides. A standard Git checkout needs no .env file:
# repository owner/name are inferred from `git remote get-url origin`
# and the branch is inferred from `git branch --show-current`.

# SITE_REPOSITORY=owner/repository
# SITE_OWNER=owner
# SITE_REF=main

# Optional settings
# SITE_EXCLUDE_REPOS=repo-a,repo-b       # additional repositories to exclude from the list
# SITE_INCLUDE_SITE_REPO=true            # include the website repository itself
# SITE_URL=https://example.org           # custom domain (HTTPS, no path)
# SITE_BASE=/                            # base path for a custom domain
# GITHUB_SERVER_URL=https://github.com   # GitHub Enterprise Server URL, if different
# GITHUB_API_URL=https://api.github.com   # API URL; for GHES, this may include /api/v3
